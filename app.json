{
  "expo": {
    "name": "Haven",
    "slug": "haven-app",
    "scheme": "haven",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF3E6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haven.app"
    },
    "android": {
      "package": "com.haven.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#FFF3E6"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2cf71ab-191a-435c-a4b7-aeabd6e69914"
      }
    },
    "owner": "sarah-frankle"
  }
}
